{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/jobs/sidecar-structured-content.schema.json",
  "title": "SidecarStructuredContent",
  "description": "The `structuredContent` of a `sidecar` provider tool: under each composed RPC method that ran, its outcome as the direct request would have answered, `result` or the JSON-RPC `error`. File bytes are moved out of `result` into the call's `content`.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
  },
  "additionalProperties": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["result"],
        "additionalProperties": true
      },
      {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "../bootstrap/json-rpc-envelope.schema.json#/definitions/ErrorResponse/properties/error"
          }
        },
        "required": ["error"],
        "additionalProperties": true
      }
    ]
  }
}
