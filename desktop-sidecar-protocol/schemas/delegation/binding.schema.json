{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/binding.schema.json",
  "title": "LocalTaskBinding",
  "type": "object",
  "properties": {
    "backendOrigin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "planDigest": {
      "$ref": "../common.schema.json#/definitions/Digest"
    }
  },
  "required": [
    "backendOrigin",
    "accountId",
    "deviceId",
    "taskId",
    "jobId",
    "attemptId",
    "toolCallId",
    "planDigest"
  ],
  "additionalProperties": false
}
