{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/plan.schema.json",
  "title": "LocalTaskPlan",
  "type": "object",
  "properties": {
    "operation": {
      "const": "collect_evidence"
    },
    "queryVariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "maxHits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxArtifacts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12582912
    },
    "executionSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "operation",
    "queryVariants",
    "maxHits",
    "maxArtifacts",
    "maxBytes",
    "executionSeconds",
    "expiresAt"
  ],
  "additionalProperties": false
}
