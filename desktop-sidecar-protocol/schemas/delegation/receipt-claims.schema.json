{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/receipt-claims.schema.json",
  "title": "LocalExportReceiptClaims",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "aud": {
      "const": "erato-local-export-receipt-v1"
    },
    "binding": {
      "$ref": "../delegation/binding.schema.json"
    },
    "exportId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "manifestDigest": {
      "$ref": "../common.schema.json#/definitions/Digest"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "acceptedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "iss",
    "aud",
    "binding",
    "exportId",
    "manifestDigest",
    "receiptId",
    "acceptedAt"
  ],
  "additionalProperties": false
}
