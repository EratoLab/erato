{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/methods/outlook-get-conversation-v1-result.schema.json",
  "title": "OutlookGetConversationV1Result",
  "description": "The messages of the anchored conversation, oldest first, with attachment bytes referenced by transfer handle.",
  "type": "object",
  "required": ["messages"],
  "properties": {
    "mailbox": {
      "$ref": "../outlook/mailbox.schema.json"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "../outlook/conversation-message.schema.json"
      }
    }
  },
  "additionalProperties": true
}
