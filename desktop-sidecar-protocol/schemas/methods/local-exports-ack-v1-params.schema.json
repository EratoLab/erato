{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/methods/local-exports-ack-v1-params.schema.json",
  "title": "LocalExportsAckV1Params",
  "type": "object",
  "properties": {
    "contextHandle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "receipt": {
      "type": "string",
      "minLength": 32,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  },
  "required": ["contextHandle", "handle", "receipt"],
  "additionalProperties": false
}
