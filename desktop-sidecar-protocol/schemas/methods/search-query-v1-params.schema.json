{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/methods/search-query-v1-params.schema.json",
  "title": "SearchQueryV1Params",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 4096,
      "default": ""
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "filters": {
      "type": "object",
      "properties": {
        "sender": {
          "type": "string"
        },
        "mailboxId": {
          "type": "string"
        },
        "dateFrom": {
          "type": "integer"
        },
        "dateTo": {
          "type": "integer"
        },
        "fileType": {
          "type": "string"
        },
        "kind": {
          "enum": ["email", "file"],
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
