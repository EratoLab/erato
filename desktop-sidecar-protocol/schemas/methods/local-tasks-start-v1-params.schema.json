{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/methods/local-tasks-start-v1-params.schema.json",
  "title": "LocalTasksStartV1Params",
  "type": "object",
  "properties": {
    "contextHandle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "binding": {
      "$ref": "../delegation/binding.schema.json"
    },
    "plan": {
      "$ref": "../delegation/plan.schema.json"
    },
    "authorization": {
      "type": "string",
      "minLength": 32,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  },
  "required": ["contextHandle", "binding", "plan", "authorization"],
  "additionalProperties": false
}
