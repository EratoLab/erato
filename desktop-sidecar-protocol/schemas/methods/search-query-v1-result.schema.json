{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.erato.ai/desktop-sidecar/v1/methods/search-query-v1-result.schema.json",
  "title": "SearchQueryV1Result",
  "type": "object",
  "properties": {
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "uri": {
            "description": "A URI identifying the document, ideally an externally retrievable URL.",
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "external_ids": {
            "$ref": "../source/external-ids.schema.json"
          },
          "chunkId": {
            "type": ["string", "null"]
          },
          "score": {
            "type": "number"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": ["string", "null"]
          },
          "sender": {
            "type": ["string", "null"]
          },
          "senderEmail": {
            "type": ["string", "null"],
            "description": "Lowercase sender address: the email sender, or the Teams sender's profile email when Teams cached one. Omitted when unknown."
          },
          "mailboxId": {
            "type": ["string", "null"]
          },
          "date": {
            "type": ["integer", "null"]
          },
          "editedAt": {
            "type": ["integer", "null"],
            "description": "Unix seconds of the last edit Teams reported for a Teams message. Reactions and read state are not edits. Omitted when the message was never edited."
          },
          "selfNote": {
            "type": "boolean",
            "description": "True for a note the user wrote to themselves: a Teams \"Chat with yourself\" message, or an email from the mailbox owner addressed only to the owner. Omitted otherwise."
          },
          "mimeType": {
            "type": ["string", "null"]
          },
          "conversationKey": {
            "type": ["string", "null"]
          },
          "topLevelParent": {
            "$ref": "../source/top-level-parent.schema.json"
          }
        },
        "required": [
          "documentId",
          "chunkId",
          "score",
          "kind",
          "title",
          "sender",
          "mailboxId",
          "date",
          "mimeType",
          "conversationKey"
        ],
        "additionalProperties": true
      }
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "blocksRead": {
      "type": "integer",
      "minimum": 0
    },
    "candidatesScored": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "$ref": "#/definitions/SearchCoverage"
    },
    "limitReached": {
      "type": "boolean",
      "description": "True when more documents matched than limit allowed to return. Older sidecars omit it."
    }
  },
  "required": ["hits", "elapsedMs", "blocksRead", "candidatesScored"],
  "additionalProperties": true,
  "definitions": {
    "SearchCoverage": {
      "type": "object",
      "properties": {
        "sampledAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the reported ranges were computed."
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "description": "index when the query matched indexed text, catalog when an empty-text listing read the discovered inventory. Extensible."
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchCoverageSource"
          }
        }
      },
      "required": ["sampledAt", "basis", "sources"],
      "additionalProperties": true,
      "description": "The period each source consulted by this query covers. Older sidecars omit it."
    },
    "SearchCoverageSource": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "mailboxId": {
          "type": ["string", "null"]
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "description": "Product family as in sources.list.v1, such as outlook or teams. Extensible."
        },
        "displayName": {
          "type": ["string", "null"]
        },
        "accountEmail": {
          "type": ["string", "null"],
          "description": "Lowercase address of the mailbox or Teams account, when known."
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/definitions/IndexedRangeBoundary"
            },
            {
              "type": "null"
            }
          ]
        },
        "through": {
          "anyOf": [
            {
              "$ref": "#/definitions/IndexedRangeBoundary"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "pendingNewer": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "olderPending": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unsearchable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "undated": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "dateBasis": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "type": "string",
          "minLength": 1
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceId",
        "mailboxId",
        "product",
        "displayName",
        "accountEmail",
        "from",
        "through",
        "observedAt",
        "pendingNewer",
        "olderPending",
        "unsearchable",
        "undated",
        "dateBasis",
        "inventory",
        "unavailableReason"
      ],
      "additionalProperties": true,
      "description": "A source's identity and its indexed range, with the same range fields and values as indexing.status.v1 discovery[].indexedRange."
    },
    "IndexedRangeBoundary": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "inclusive": {
          "type": "boolean"
        }
      },
      "required": ["at", "inclusive"],
      "additionalProperties": true
    }
  }
}
