{
  "name": "run two independent tool calls as one job, one of them failing, then acknowledge",
  "messages": [
    {
      "direction": "client-to-sidecar",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-job-start",
        "method": "jobs.start.v1",
        "params": {
          "calls": [
            {
              "server": "sidecar",
              "name": "list_sidecar_mailboxes",
              "arguments": {}
            },
            {
              "server": "sidecar",
              "name": "read_sidecar_conversation",
              "arguments": {
                "mailboxId": "00000000000000000000000000000000",
                "internetMessageId": "<message-1@example.com>"
              }
            }
          ],
          "wait_ms": 10000
        },
        "x-erato-deadline-at": "2026-11-02T10:00:20.000Z"
      }
    },
    {
      "direction": "sidecar-to-client",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-job-start",
        "result": {
          "handle": "job-handle-0123456789abcdefghijklmnopqrstuv",
          "state": "completed",
          "results": [
            {
              "result": {
                "content": [
                  { "type": "text", "text": "Work <work@example.com>" }
                ],
                "structuredContent": {
                  "mailboxes": [
                    {
                      "id": "8b7d2f4a6c9e1035d8a1b2c3e4f50617",
                      "displayName": "Work",
                      "emailAddress": "work@example.com",
                      "profileName": "Work Profile",
                      "source": "windowsOutlook"
                    }
                  ],
                  "warnings": []
                }
              }
            },
            {
              "error": {
                "code": -32602,
                "message": "Unknown Outlook mailbox."
              }
            }
          ]
        }
      }
    },
    {
      "direction": "client-to-sidecar",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-job-ack",
        "method": "jobs.ack.v1",
        "params": { "handle": "job-handle-0123456789abcdefghijklmnopqrstuv" }
      }
    },
    {
      "direction": "sidecar-to-client",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-job-ack",
        "result": {
          "handle": "job-handle-0123456789abcdefghijklmnopqrstuv",
          "state": "acked"
        }
      }
    }
  ]
}
