      }
    },
    {
      "direction": "client-to-sidecar",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-cancel",
        "method": "erato.cancel",
        "params": { "requestId": "c-echo-cancelled", "reason": "user" }
      }
    },
    {
      "direction": "sidecar-to-client",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-cancel",
        "result": { "accepted": true }
      }
    },
    {
      "direction": "sidecar-to-client",
      "message": {
        "jsonrpc": "2.0",
        "id": "c-echo-cancelled",
        "error": {
          "code": -32014,
          "message": "The request was cancelled.",
          "data": {
            "kind": "request_cancelled",
            "requestId": "c-echo-cancelled"
          }
        }
      }
    },
    {
      "direction": "client-to-sidecar",
      "message": {
        "jsonrpc": "2.0",
