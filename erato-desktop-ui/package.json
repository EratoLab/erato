{
  "name": "@erato/desktop-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm i18n:compile && tsc && vite build",
    "package": "node scripts/package.mjs",
    "check": "pnpm run format:check && pnpm run lint:strict && pnpm run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "i18n:extract": "lingui extract",
    "i18n:extract:check": "./scripts/check-i18n-extract.sh",
    "i18n:compile": "lingui compile",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@erato/frontend": "file:../frontend/dist-package/erato-frontend.tgz",
    "@erato/frontend-utils": "file:../frontend-utils",
    "@lingui/core": "5.9.4",
    "@lingui/react": "5.9.4",
    "@tanstack/query-core": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-devtools": "5.100.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.28.0",
    "@lingui/babel-plugin-lingui-macro": "5.9.4",
    "@lingui/cli": "5.9.4",
    "@lingui/vite-plugin": "5.9.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lingui": "^0.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.0.1",
    "prettier": "3.5.0",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^4.1.7"
  }
}
