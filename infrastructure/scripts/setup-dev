import argparse
import atexit
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Optional
import re
import tempfile
from pydantic import BaseModel, Field

# Import shared k3d utilities
from k3d_common import get_helm_scenario_args, validate_scenario, VALID_SCENARIOS


class ScriptConfig(BaseModel):
    """Configuration for the setup script."""
    wait_flag: str = ""
    erato_image_repository: str = "registry.eratolabs.com/erato/app"
    erato_image_tag: Optional[str] = None
    mock_llm_server_image_tag: Optional[str] = None
    mock_mcp_server_image_tag: Optional[str] = None
    build_local: bool = False
    helm_set_args: list[str] = Field(default_factory=list)
    chart_dep_update: bool = False
    with_telepresence: bool = False
    file_storage_config_source: Optional[str] = None
    test_scenario: str = "basic"
    deployment_kubeconfig: Optional[Path] = None


class ClusterConfig(BaseModel):
    """Configuration for the k3d cluster."""
    cluster_name: str = "erato-dev"
    erato_chart_path: Path = Path("./charts/erato")
    chart_path: Path = Path("./k3d/erato-local")
    app_host: str = "app.erato.internal"
    dex_host: str = "dex.erato.internal"


class ClusterStatus(BaseModel):
    """Status of a k3d cluster."""
    exists: bool
    running: bool


class BuildConfig(BaseModel):
    """Configuration for local image build."""
    project_root: Path
    build_tag: str
    # The k3d-managed registry the cluster pulls from. `Dockerfile.combined`
    # resolves BOTH of its FROMs through this one value, so every image it
    # composes has to be published here.
    local_registry: str = "k3d-registry.localhost:5000"
    frontend_image_name: str = "erato/frontend"
    repo_base: str
    tag_base: str
    backend_image_repo: str
    base_backend_image: str
    combined_image_path: str
    sqitch_migrator_image_path: str
    local_frontend_image: str
    local_backend_image: str
    local_combined_image: str
    local_sqitch_migrator_image: str
    backend_image_for_build_arg: str


def run_command(cmd: list[str], check: bool = True, capture_output: bool = False, 
                shell: bool = False, input: Optional[str] = None, cwd: Optional[Path] = None) -> subprocess.CompletedProcess:
    """Run a shell command with error handling."""
    try:
        if shell:
            cmd_str = " ".join(cmd) if isinstance(cmd, list) else cmd
            result = subprocess.run(cmd_str, shell=True, check=check, 
                                  capture_output=capture_output, text=True, 
                                  input=input, cwd=cwd)
        else:
            result = subprocess.run(cmd, check=check, capture_output=capture_output, 
                                  text=True, input=input, cwd=cwd)
        return result
    except subprocess.CalledProcessError as e:
        print(f"Error running command: {' '.join(cmd)}", file=sys.stderr)
        if e.stderr:
            print(f"Stderr: {e.stderr}", file=sys.stderr)
        if check:
            sys.exit(1)
        raise
    except FileNotFoundError:
        print(f"Error: Command not found: {cmd[0]}", file=sys.stderr)
        sys.exit(1)


def check_prerequisites():
    """Check if required commands are available."""
    required_commands = ["k3d", "kubectl", "helm"]
    for cmd in required_commands:
        result = run_command(["which", cmd], check=False, capture_output=True)
        if result.returncode != 0:
            print(f"{cmd} is required but not installed. Aborting.", file=sys.stderr)
            sys.exit(1)


def check_e2e_secrets() -> bool:
    """Check if E2E secrets are configured.

    Returns:
        True if secrets are configured, False otherwise
    """
    script_dir = Path(__file__).resolve().parent
    try:
        result = run_command(
            [str(script_dir / "setup-e2e-secrets"), "check"],
            check=False,
            capture_output=True
        )
        return result.returncode == 0
    except Exception:
        return False


def fetch_latest_main_commit() -> str:
    """Fetch and return the latest commit SHA from upstream main branch.

    Returns:
        The commit SHA of the latest commit on origin/main

    Raises:
        SystemExit if git operations fail
    """
    print("Fetching latest commit from upstream main branch...")

    # Fetch the latest from origin
    result = run_command(
        ["git", "fetch", "origin", "main"],
        capture_output=True,
        check=False
    )

    if result.returncode != 0:
        print("Error: Failed to fetch from origin/main", file=sys.stderr)
        print(f"Git error: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    # Get the commit SHA of origin/main
    result = run_command(
        ["git", "rev-parse", "origin/main"],
        capture_output=True,
        check=False
    )

    if result.returncode != 0:
        print("Error: Failed to get commit SHA from origin/main", file=sys.stderr)
        print(f"Git error: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    commit_sha = result.stdout.strip()
    print(f"✓ Using commit from origin/main: {commit_sha}")

    return commit_sha


def get_cluster_status(cluster_name: str) -> ClusterStatus:
    """Check if a k3d cluster exists and if it's running."""
    import json
    
    result = run_command(["k3d", "cluster", "list", "--output", "json"], capture_output=True)
    
    try:
        clusters = json.loads(result.stdout)
        for cluster in clusters:
            if cluster.get("name") == cluster_name:
                # Check if all expected nodes are running
                servers_running = cluster.get("serversRunning", 0)
                servers_count = cluster.get("serversCount", 0)
                agents_running = cluster.get("agentsRunning", 0)
                agents_count = cluster.get("agentsCount", 0)
                
                # Cluster is running if all servers and agents are running
                is_running = (servers_running == servers_count and 
                            agents_running == agents_count and 
                            servers_count > 0)
                
                return ClusterStatus(exists=True, running=is_running)
        
        return ClusterStatus(exists=False, running=False)
    except json.JSONDecodeError:
        # Fallback if JSON parsing fails
        print("Warning: Could not parse k3d cluster list output", file=sys.stderr)
        return ClusterStatus(exists=False, running=False)


def create_or_use_cluster(cluster_config: ClusterConfig):
    """Create k3d cluster if it doesn't exist, start it if stopped, otherwise use existing."""
    status = get_cluster_status(cluster_config.cluster_name)
    
    if not status.exists:
        print(f"Creating k3d cluster '{cluster_config.cluster_name}'...")
        run_command([
            "k3d", "cluster", "create",
            cluster_config.cluster_name,
            "--config", "k3d/cluster-config.yaml"
        ])
    elif not status.running:
        print(f"Starting existing cluster '{cluster_config.cluster_name}'...")
        run_command(["k3d", "cluster", "start", cluster_config.cluster_name])
    else:
        print(f"Using existing cluster '{cluster_config.cluster_name}'...")


def wait_for_cluster():
    """Wait for cluster nodes to be ready."""
    print("Waiting for cluster to be ready...")
    
    # Retry a few times in case the API server isn't immediately available
    max_retries = 5
    for attempt in range(1, max_retries + 1):
        result = run_command([
            "kubectl", "wait", "--for=condition=Ready",
            "nodes", "--all", "--timeout=60s"
        ], check=False, capture_output=True)
        
        if result.returncode == 0:
            return
        
        if attempt < max_retries:
            print(f"Attempt {attempt}/{max_retries}: Cluster not ready yet, waiting 5 seconds...")
            time.sleep(5)
        else:
            print("Error: Cluster did not become ready in time", file=sys.stderr)
            print(f"Last error: {result.stderr}", file=sys.stderr)
            sys.exit(1)


def wait_for_coredns():
    """Wait for CoreDNS to be ready."""
    print("Waiting for CoreDNS to be ready...")
    run_command([
        "kubectl", "-n", "kube-system", "wait",
        "--for=condition=Available", "deployment/coredns",
        "--timeout=60s"
    ])


def add_helm_repos():
    """Add required Helm repositories."""
    repos = [
        ("bitnami", "https://charts.bitnami.com/bitnami"),
        ("cnpg", "https://raw.githubusercontent.com/cloudnative-pg/charts/gh-pages"),
        ("datawire", "https://app.getambassador.io"),
        ("seaweedfs", "https://seaweedfs.github.io/seaweedfs/helm"),
    ]
    for name, url in repos:
        run_command(["helm", "repo", "add", name, url], check=False, capture_output=True)


def update_chart_dependencies(config: ScriptConfig, cluster_config: ClusterConfig):
    """Update Helm chart dependencies if requested."""
    if config.chart_dep_update:
        print("Updating chart dependencies...")
        # Update dependencies for both charts.
        # We don't run 'helm repo update' separately as 'helm dependency update'
        # already does this. We use --skip-refresh for the second chart to avoid
        # redundant repository updates.
        run_command(["helm", "dependency", "update", str(cluster_config.erato_chart_path)])
        run_command(["helm", "dependency", "update", "--skip-refresh", str(cluster_config.chart_path)])


def derive_sqitch_migrator_repository(erato_image_repository: str) -> str:
    """Derive the Sqitch migrator image repository from the Erato app image repository."""
    if erato_image_repository.endswith("/app"):
        return f"{erato_image_repository[:-4]}/app-sqitch-migrator"
    return f"{erato_image_repository}-sqitch-migrator"


def configure_helm_args(config: ScriptConfig) -> list[str]:
    """Configure Helm arguments based on script config."""
    helm_args = config.helm_set_args.copy()
    
    if config.erato_image_repository:
        helm_args.extend(["--set", f"erato.backend.image.repository={config.erato_image_repository}"])
        helm_args.extend([
            "--set",
            f"erato.backend.migrations.image.repository={derive_sqitch_migrator_repository(config.erato_image_repository)}",
        ])
    
    # --set-string, not --set: a purely numeric tag (the local build uses a unix
    # timestamp) is stored as a number, and a later `helm upgrade --reuse-values`
    # - which is how switch-test-scenario changes scenario - re-renders it in
    # scientific notation, so the pod comes up ImagePullBackOff on a tag nobody
    # ever built.
    if config.erato_image_tag:
        helm_args.extend(["--set-string", f"erato.backend.image.tag={config.erato_image_tag}"])
        helm_args.extend([
            "--set-string",
            f"erato.backend.migrations.image.tag={config.erato_image_tag}",
        ])

    return helm_args


def configure_mock_llm_server_helm_args(config: ScriptConfig) -> list[str]:
    """Configure mock-llm-server image values.

    The mock image tag can be set independently. If unset, it falls back to the
    main erato image tag when that is provided.
    """
    helm_args: list[str] = []

    mock_repo = None
    if config.erato_image_repository.endswith("/app"):
        mock_repo = f"{config.erato_image_repository[:-4]}/mock-llm-server"

    if mock_repo:
        helm_args.extend(["--set", f"mockLlmServer.image.repository={mock_repo}"])

    effective_mock_tag = config.mock_llm_server_image_tag or config.erato_image_tag
    if effective_mock_tag:
        helm_args.extend(["--set-string", f"mockLlmServer.image.tag={effective_mock_tag}"])

    return helm_args


def configure_mock_mcp_server_helm_args(config: ScriptConfig) -> list[str]:
    """Configure mock-mcp-server image values.

    The mock image tag can be set independently. If unset, it falls back to the
    main erato image tag when that is provided.
    """
    helm_args: list[str] = []

    mock_repo = None
    if config.erato_image_repository.endswith("/app"):
        mock_repo = f"{config.erato_image_repository[:-4]}/mock-mcp-server"

    if mock_repo:
        helm_args.extend(["--set", f"mockMcpServer.image.repository={mock_repo}"])

    effective_mock_tag = config.mock_mcp_server_image_tag or config.erato_image_tag
    if effective_mock_tag:
        helm_args.extend(["--set-string", f"mockMcpServer.image.tag={effective_mock_tag}"])

    return helm_args


def perform_local_build(config: ScriptConfig) -> list[str]:
    """Perform local build and return Helm arguments."""
    project_root = Path(__file__).resolve().parent.parent.parent
    build_tag = str(int(datetime.now().timestamp()))
    
    repo_base = config.erato_image_repository or "registry.eratolabs.com/erato/app"
    tag_base = config.erato_image_tag or "latest"
    
    backend_image_repo = repo_base.replace("/app", "/backend")
    base_backend_image = f"{backend_image_repo}:{tag_base}"
    print(f"Using base backend image: {base_backend_image}")
    
    backend_image_path = "/".join(backend_image_repo.split("/")[1:])
    combined_image_path = "/".join(repo_base.split("/")[1:])
    sqitch_migrator_image_path = "/".join(
        derive_sqitch_migrator_repository(repo_base).split("/")[1:]
    )
    
    build_config = BuildConfig(
        project_root=project_root,
        build_tag=build_tag,
        repo_base=repo_base,
        tag_base=tag_base,
        backend_image_repo=backend_image_repo,
        base_backend_image=base_backend_image,
        combined_image_path=combined_image_path,
        sqitch_migrator_image_path=sqitch_migrator_image_path,
        local_frontend_image=f"k3d-registry.localhost:5000/erato/frontend:{build_tag}",
        local_backend_image=f"k3d-registry.localhost:5000/{backend_image_path}:{build_tag}",
        local_combined_image=f"k3d-registry.localhost:5000/{combined_image_path}:{build_tag}",
        local_sqitch_migrator_image=(
            f"k3d-registry.localhost:5000/{sqitch_migrator_image_path}:{build_tag}"
        ),
        backend_image_for_build_arg=f"{backend_image_path}:{build_tag}"
    )
    
    # Built from source, not pulled: a local build exists to run the working
    # tree, and the backend is where most of it lives. cargo-chef caches the
    # dependency compile, so only the first build pays for it.
    print(f"Building backend image: {build_config.local_backend_image}")
    run_command([
        "docker", "build",
        "-t", build_config.local_backend_image,
        "-f", str(build_config.project_root / "backend" / "Dockerfile"),
        str(build_config.project_root / "backend"),
    ])
    run_command(["docker", "push", build_config.local_backend_image])

    print(f"Building frontend image: {build_config.local_frontend_image}")
    run_command([
        "docker", "build",
        "-t", build_config.local_frontend_image,
        "-f", str(build_config.project_root / "frontend" / "Dockerfile"),
        # Repo root, not frontend/: the Dockerfile copies desktop-sidecar-protocol,
        # frontend-utils, scripts and office-addin alongside frontend itself. This
        # is the context CI builds it with.
        str(build_config.project_root),
    ])
    run_command(["docker", "push", build_config.local_frontend_image])
    
    print(f"Building combined image: {build_config.local_combined_image}")
    run_command([
        "docker", "build",
        "--build-arg", f"REGISTRY={build_config.local_registry}",
        "--build-arg", f"FRONTEND_IMAGE={build_config.frontend_image_name}:{build_config.build_tag}",
        "--build-arg", f"BACKEND_IMAGE={build_config.backend_image_for_build_arg}",
        "-t", build_config.local_combined_image,
        "-f", str(build_config.project_root / "Dockerfile.combined"),
        str(build_config.project_root),
    ])
    run_command(["docker", "push", build_config.local_combined_image])

    print(f"Building Sqitch migrator image: {build_config.local_sqitch_migrator_image}")
    run_command([
        "docker", "build",
        "-t", build_config.local_sqitch_migrator_image,
        "-f", str(build_config.project_root / "backend" / "Dockerfile.sqitch-migrator"),
        str(build_config.project_root / "backend"),
    ])
    run_command(["docker", "push", build_config.local_sqitch_migrator_image])
    
    # The tags go in with --set-string for the reason given in
    # configure_helm_args: this build tag is a bare unix timestamp, and a
    # numeric value does not survive a later --reuse-values upgrade.
    return [
        "--set", f"erato.backend.image.repository=k3d-registry.localhost:5000/{build_config.combined_image_path}",
        "--set-string", f"erato.backend.image.tag={build_config.build_tag}",
        "--set",
        (
            "erato.backend.migrations.image.repository="
            f"k3d-registry.localhost:5000/{build_config.sqitch_migrator_image_path}"
        ),
        "--set-string", f"erato.backend.migrations.image.tag={build_config.build_tag}"
    ]


def handle_file_storage_config(config: ScriptConfig) -> list[str]:
    """Handle file storage configuration source."""
    if not config.file_storage_config_source:
        return []
    
    return ["--set", f"fileStorageConfig.sourceFile={config.file_storage_config_source}"]


def helm_release_exists(namespace: str, release_name: str) -> bool:
    """Check if a Helm release exists."""
    result = run_command(
        ["helm", "list", "-n", namespace],
        capture_output=True,
        check=False
    )
    for line in result.stdout.splitlines():
        if line.startswith(release_name):
            return True
    return False


def install_nginx_ingress():
    """Install nginx ingress controller."""
    print("Installing nginx ingress controller...")
    if not helm_release_exists("ingress-nginx", "ingress-nginx"):
        print("Installing nginx ingress controller...")
        run_command([
            "helm", "upgrade", "--install", "ingress-nginx", "ingress-nginx",
            "--repo", "https://kubernetes.github.io/ingress-nginx",
            "--namespace", "ingress-nginx", "--create-namespace"
        ])
    else:
        print("nginx ingress controller already installed, skipping...")


def install_telepresence(config: ScriptConfig):
    """Install Telepresence if requested."""
    if config.with_telepresence:
        if not helm_release_exists("ambassador", "traffic-manager"):
            print("Installing Telepresence...")
            run_command(["telepresence", "helm", "install"])
        else:
            print("Telepresence already installed, skipping...")
    else:
        print("Skipping Telepresence installation (use --with-telepresence to enable)")


def install_cnpg():
    """Install CNPG operator."""
    if not helm_release_exists("cnpg-system", "cnpg"):
        print("Installing CNPG operator...")
        run_command([
            "helm", "upgrade", "--install", "cnpg",
            "--namespace", "cnpg-system",
            "--create-namespace",
            "cnpg/cloudnative-pg"
        ])
    else:
        print("CNPG operator already installed, skipping...")


def install_reloader():
    """Install Reloader for ConfigMap auto-reloading."""
    # Check if reloader is already installed by checking for the deployment
    # Reloader is typically installed in the default namespace
    result = run_command([
        "kubectl", "get", "deployment",
        "reloader-reloader",
        "-n", "default"
    ], capture_output=True, check=False)
    
    if result.returncode == 0:
        print("Reloader already installed, skipping...")
        return
    
    print("Installing Reloader for ConfigMap auto-reloading...")
    run_command([
        "kubectl", "apply", "-f",
        "https://raw.githubusercontent.com/stakater/Reloader/master/deployments/kubernetes/reloader.yaml"
    ])


def wait_for_webhook(namespace: str, service_name: str, webhook_name: str, max_attempts: int = 60):
    """Wait for a webhook service to be ready."""
    print(f"Waiting for {webhook_name} to be ready...")
    
    for attempt in range(1, max_attempts + 1):
        result = run_command([
            "kubectl", "get", "endpoints",
            "-n", namespace, service_name,
            "-o", "jsonpath={.subsets[*].addresses[*].ip}"
        ], capture_output=True, check=False)
        
        if result.returncode == 0 and result.stdout.strip():
            print("Webhook is ready!")
            return
        
        print(f"Attempt {attempt}/{max_attempts}: Webhook not ready, waiting 5 seconds...")
        time.sleep(5)
    
    print("Timeout: Webhook did not become ready", file=sys.stderr)
    sys.exit(1)


def start_kubernetes_event_stream(namespace: str) -> subprocess.Popen:
    """Stream namespace events while the local chart is being deployed."""
    print(f"Streaming Kubernetes events in namespace {namespace}...")
    return subprocess.Popen(
        [
            "kubectl",
            "get",
            "events",
            "--namespace",
            namespace,
            "--watch",
            "--output=wide",
        ],
        stdout=sys.stdout,
        stderr=sys.stderr,
        text=True,
    )


def ensure_kubernetes_namespace(namespace: str) -> None:
    """Ensure the event stream's namespace exists before watching it."""
    result = run_command(
        ["kubectl", "get", "namespace", namespace],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        run_command(["kubectl", "create", "namespace", namespace])


def stop_kubernetes_event_stream(event_stream: subprocess.Popen) -> None:
    """Stop the namespace event stream after the chart command finishes."""
    if event_stream.poll() is not None:
        return

    event_stream.terminate()
    try:
        event_stream.wait(timeout=5)
    except subprocess.TimeoutExpired:
        event_stream.kill()
        event_stream.wait()


def print_kubernetes_diagnostics(namespace: str) -> None:
    """Print cluster and workload diagnostics after a failed chart deployment."""
    diagnostics = [
        (
            f"All Kubernetes events (including node/scheduling events)"
            f" when deployment failed:",
            [
                "kubectl",
                "get",
                "events",
                "--all-namespaces",
                "--output=wide",
                "--sort-by=.lastTimestamp",
            ],
        ),
        (
            "Node status and capacity:",
            ["kubectl", "get", "nodes", "--output=wide"],
        ),
        (
            "Node conditions and allocatable resources:",
            ["kubectl", "describe", "nodes"],
        ),
        (
            f"Workload status in namespace {namespace}:",
            [
                "kubectl",
                "get",
                "pods,deployments,replicasets,statefulsets,jobs",
                "--namespace",
                namespace,
                "--output=wide",
            ],
        ),
        (
            f"Deployment details in namespace {namespace}:",
            ["kubectl", "describe", "deployments", "--namespace", namespace],
        ),
        (
            f"Pod details in namespace {namespace}:",
            ["kubectl", "describe", "pods", "--namespace", namespace],
        ),
        (
            f"Recent backend container logs in namespace {namespace}:",
            [
                "kubectl",
                "logs",
                "--namespace",
                namespace,
                "--selector=app.kubernetes.io/component=erato-app",
                "--all-containers",
                "--prefix",
                "--tail=200",
            ],
        ),
    ]

    for heading, command in diagnostics:
        print(f"\n{heading}", flush=True)
        result = run_command(command, check=False, capture_output=True)
        if result.stdout:
            print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
        if result.stderr:
            print(result.stderr, end="" if result.stderr.endswith("\n") else "\n", file=sys.stderr)
        if not result.stdout and not result.stderr:
            print(f"(no output; kubectl exited with status {result.returncode})")


def install_erato_chart(config: ScriptConfig, cluster_config: ClusterConfig, helm_args: list[str]):
    """Install/upgrade Erato local development chart."""
    print("Installing/upgrading Erato local development chart...")
    
    cmd = [
        "helm", "upgrade", "--install", "erato-local",
        str(cluster_config.chart_path),
        "--namespace", "erato-local-ns"
    ]
    if config.deployment_kubeconfig:
        cmd.extend(["--kubeconfig", str(config.deployment_kubeconfig)])
    
    if config.wait_flag:
        cmd.append(config.wait_flag)
    
    cmd.extend(helm_args)
    
    print(f"Running: {' '.join(cmd)}")
    ensure_kubernetes_namespace("erato-local-ns")
    event_stream = start_kubernetes_event_stream("erato-local-ns")
    try:
        result = run_command(cmd, check=False)
    finally:
        stop_kubernetes_event_stream(event_stream)

    if result.returncode != 0:
        print_kubernetes_diagnostics("erato-local-ns")
        sys.exit(result.returncode)


def ensure_hosts_entries(cluster_config: ClusterConfig):
    """Ensure local DNS entries exist in /etc/hosts."""
    hosts = [
        cluster_config.app_host,
        cluster_config.dex_host,
        "k3d-registry.localhost"
    ]
    
    try:
        with open("/etc/hosts", "r") as f:
            hosts_content = f.read()
    except PermissionError:
        print("Warning: Cannot read /etc/hosts. You may need to add entries manually.", file=sys.stderr)
        return
    
    for host in hosts:
        if host not in hosts_content:
            print(f"Adding {host} to /etc/hosts...")
            entry = f"127.0.0.1 {host}\n"
            try:
                result = run_command(
                    ["sudo", "tee", "-a", "/etc/hosts"],
                    capture_output=True,
                    input=entry
                )
            except Exception as e:
                print(f"Warning: Could not add {host} to /etc/hosts: {e}", file=sys.stderr)
                print(f"Please manually add: 127.0.0.1 {host}", file=sys.stderr)


def print_completion_message(cluster_config: ClusterConfig, config: ScriptConfig = None):
    """Print completion message with access information."""
    print()
    print("Setup complete! Your development environment is ready.")
    print(f"Access the application at: https://{cluster_config.app_host}")
    print(f"Access Dex at: https://{cluster_config.dex_host}")
    print()
    print("Default login credentials:")
    print("  Username: admin@example.com")
    print("  Password: admin")

    # Print nginx-auth scenario specific information
    if config and config.test_scenario == "nginx-auth":
        print()
        print("📱 Nginx-Auth Scenario Enabled:")
        print("  Access embedded test page at: https://embedded-host.erato.internal")
        print("  (This URL is only available in the nginx-auth scenario)")


def deploy_existing_environment(args: argparse.Namespace, config: ScriptConfig) -> None:
    """Deploy into a pre-provisioned namespace using its limited kubeconfig."""
    import yaml

    if not args.kubeconfig or not args.kubeconfig.is_file():
        raise SystemExit("--target existing requires --kubeconfig from setup-dev-service-account")
    if not args.environment:
        raise SystemExit("--target existing requires a unique --environment identity")
    # The local chart pins the source checkout's image SHA, which may not have
    # been published (for example when deploying this branch). Remote targets
    # default to the registry's CI-published multi-architecture image instead.
    if not config.erato_image_tag:
        config.erato_image_tag = "latest"
    tailscale_ingress = args.ingress_class == "tailscale"
    if not tailscale_ingress and not args.tls_secret_name:
        raise SystemExit("Private nginx deployments require --tls-secret-name")

    environment = args.environment.lower()
    if not re.fullmatch(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?", environment) or len(environment) > 29:
        raise SystemExit("--environment must be a DNS label of at most 29 characters")
    namespace = args.namespace or f"erato-{environment}"
    release = args.release_name or f"erato-{environment}"
    domain = args.domain_suffix.lstrip(".")
    domain_labels = domain.split(".")
    valid_domain_suffix = domain.endswith("ts.net") if tailscale_ingress else domain.endswith("erato.internal")
    if (
        not valid_domain_suffix
        or any(not re.fullmatch(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?", label) or len(label) > 63 for label in domain_labels)
    ):
        expected_domain = "a Tailscale MagicDNS suffix ending in ts.net" if tailscale_ingress else "a private domain ending in erato.internal"
        raise SystemExit(f"--domain-suffix must be {expected_domain} and contain only lowercase DNS characters")

    app_host = f"app-{environment}.{domain}"
    dex_host = f"dex-{environment}.{domain}"
    embedded_host = f"embedded-host-{environment}.{domain}"
    app_url = f"https://{app_host}"
    dex_url = f"https://{dex_host}"
    if not re.fullmatch(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?", namespace) or len(namespace) > 63:
        raise SystemExit("--namespace must be a Kubernetes DNS label of at most 63 characters")
    if not re.fullmatch(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?", release) or len(release) > 63:
        raise SystemExit("--release-name must be a Kubernetes DNS label of at most 63 characters")
    if len(f"{release}-erato-backend-load-balancer") > 63:
        raise SystemExit("--release-name is too long for the chart's backend load-balancer service account")
    release_fullname = release if "erato-local" in release else f"{release}-erato-local"
    internal_dex_url = f"http://{release}-dex.{namespace}.svc.cluster.local:5556"
    chart_path = Path(__file__).resolve().parent.parent / "k3d" / "erato-local"
    verify_deployer_kubeconfig(args.kubeconfig, namespace, args.deployer_service_account)

    scenario_secret_path = args.scenario_secrets_file
    if scenario_secret_path and not scenario_secret_path.is_file():
        raise SystemExit(f"Scenario secrets file not found: {scenario_secret_path}")
    if scenario_secret_path:
        marker = re.search(r'(?m)^K3D_TEST_SCENARIO\s*=\s*"([^"]+)"', scenario_secret_path.read_text(encoding="utf-8"))
        if marker and marker.group(1) != config.test_scenario:
            raise SystemExit(f"Scenario secrets are for '{marker.group(1)}', but --scenario selects '{config.test_scenario}'")
    if config.chart_dep_update:
        run_command(["helm", "dependency", "update", str(chart_path)])
    if config.test_scenario == "entra_id" and not args.e2e_secrets_file:
        raise SystemExit("--scenario entra_id requires --e2e-secrets-file with the Entra tenant/client credentials")

    helm_args = configure_helm_args(config)
    helm_args.extend(handle_file_storage_config(config))
    helm_args.extend(configure_mock_llm_server_helm_args(config))
    helm_args.extend(configure_mock_mcp_server_helm_args(config))
    helm_args.extend(get_helm_scenario_args(config.test_scenario))
    app_tls_host = f"app-{environment}" if tailscale_ingress else app_host
    dex_tls_host = f"dex-{environment}" if tailscale_ingress else dex_host
    embedded_tls_host = f"embedded-host-{environment}" if tailscale_ingress else embedded_host
    helm_args.extend([
        "--set", "scenarioSecretsConfig.includeLocalFiles=false",
        "--set", "scenarioSecretsConfig.enabled=false",
        "--set", f"scenarioSecretsConfig.scenario={config.test_scenario}",
        "--set", f"erato.deployment.appHost={app_host}",
        "--set", f"erato.deployment.dexHost={dex_host}",
        "--set", f"erato.deployment.embeddedHost={embedded_host}",
        "--set", f"erato.deployment.appUrl={app_url}",
        "--set", f"erato.deployment.dexUrl={dex_url}",
        "--set", f"erato.deployment.internalDexUrl={internal_dex_url}",
        "--set", f"erato.deployment.ingressClassName={args.ingress_class}",
        "--set", f"erato.deployment.tlsSecretName={args.tls_secret_name or ''}",
        "--set", f"erato.deployment.appTlsHost={app_tls_host}",
        "--set", f"erato.deployment.dexTlsHost={dex_tls_host}",
        "--set", f"erato.deployment.embeddedTlsHost={embedded_tls_host}",
        "--set", f"erato.deployment.tailscaleTags={args.tailscale_tags}",
        "--set", f"erato.deployment.ingressTlsHost={app_tls_host}",
        "--set", f"erato.ingress.host={app_host}",
        "--set", f"erato.ingress.className={args.ingress_class}",
        "--set", f"erato.ingress.tls.enabled=true",
        "--set", f"erato.ingress.tls.secretName={args.tls_secret_name or ''}",
        "--set", f"dex.ingress.host={dex_host}",
        "--set", f"dex.ingress.className={args.ingress_class}",
        "--set", f"nginxAuth.ingress.host={app_host}",
        "--set", f"nginxAuth.ingress.className={args.ingress_class}",
        "--set", f"nginxAuth.ingress.tls.enabled=true",
        "--set", f"nginxAuth.ingress.tls.secretName={args.tls_secret_name or ''}",
        "--set", f"nginxAuth.embeddedHost.ingress.host={embedded_host}",
        "--set", f"nginxAuth.embeddedHost.ingress.className={args.ingress_class}",
        "--set", f"nginxAuth.embeddedHost.ingress.tls.enabled=true",
        "--set", f"nginxAuth.embeddedHost.ingress.tls.secretName={args.tls_secret_name or ''}",
        "--set", f"seaweedMini.serviceName={release_fullname}-seaweed-mini",
        "--set", f"erato.backend.configFile.secretName={release}-erato-toml-secret",
        "--set", f"erato.postgresql.external.connectionString.valueFrom.secretKeyRef.name={release_fullname}-postgres-app",
        "--set", "erato.backend.loadBalancer.serviceAccount.create=false",
        "--set", f"erato.backend.loadBalancer.serviceAccount.name={release}-erato-backend-load-balancer",
    ])

    extra_config_files = [
        {"name": "file-storage", "configMapName": f"{release}-erato-file-storage-config", "configMapKey": "erato.file-storage.toml"},
        {"name": "test-scenario", "configMapName": f"{release}-erato-test-scenario-config", "configMapKey": "erato.scenario.toml"},
        {"name": "frontend-env", "inlineContent": '[frontend.additional_environment]\nFOO_BAR = "true"'},
    ]
    secret_temp_paths: list[Path] = []
    if scenario_secret_path:
        scenario_contents = scenario_secret_path.read_text(encoding="utf-8")
        scenario_data_match = re.search(r"(?m)^SCENARIO_DATA\s*=.*(?:\n|$)", scenario_contents)
        private_contents = scenario_contents.replace(scenario_data_match.group(0), "") if scenario_data_match else scenario_contents
        private_contents = (
            private_contents
            .replace('{{ include "erato-local.fullname" . }}', release_fullname)
            .replace("{{ .Release.Namespace }}", namespace)
        )
        public_contents = "[frontend.additional_environment]\n"
        marker_match = re.search(r'(?m)^K3D_TEST_SCENARIO\s*=.*(?:\n|$)', scenario_contents)
        if marker_match:
            public_contents += marker_match.group(0)
        if scenario_data_match:
            public_contents += scenario_data_match.group(0)
        secret_temp_paths = []
        for suffix, contents in (("-private.toml", private_contents), ("-public.toml", public_contents)):
            fd, temporary_name = tempfile.mkstemp(suffix=suffix, prefix=f"{environment}-")
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(contents)
            secret_temp_paths.append(Path(temporary_name))
            atexit.register(lambda path=temporary_name: Path(path).unlink(missing_ok=True))

        scenario_config_files = extra_config_files + [
            {
                "name": "scenario-secrets",
                "secretName": f"{release}-erato-scenario-{config.test_scenario.replace('_', '-')}-secrets",
                "secretKey": "erato.scenario.auto.toml",
            }
        ]
        helm_args.extend([
            "--set", "scenarioSecretsConfig.enabled=true",
            "--set-file", f"scenarioSecretsConfig.remoteData={secret_temp_paths[0]}",
            "--set-file", f"scenarioSecretsConfig.remotePublicData={secret_temp_paths[1]}",
            "--set-json", f"erato.backend.extraConfigFiles={json.dumps(scenario_config_files)}",
            "--set-json", f"erato.ingress.extraPaths={json.dumps([{'path': '/e2e-scenario-data', 'pathType': 'Prefix', 'backend': {'service': {'name': f'{release}-e2e-scenario-data-server', 'port': {'name': 'http'}}}}])}",
        ])
    else:
        helm_args.extend(["--set-json", f"erato.backend.extraConfigFiles={json.dumps(extra_config_files)}"])

    if config.test_scenario == "multi-replica":
        helm_args.extend([
            "--set", "erato.backend.replicaCount=2",
            "--set", "erato.backend.loadBalancer.enabled=true",
            "--set", "erato.backend.loadBalancer.provider=kubernetesingress",
            "--set", "erato.backend.resources.requests.cpu=100m",
            "--set", "erato.backend.resources.requests.memory=250Mi",
            "--set", "erato.backend.resources.limits.cpu=100m",
            "--set", "erato.backend.resources.limits.memory=250Mi",
            "--set", "mockLlmServer.enabled=true",
        ])
    elif config.test_scenario == "nginx-auth":
        helm_args.extend([
            "--set", "erato.oauth2Proxy.enabled=false",
            "--set", "dex.enabled=false",
            "--set", "nginxAuth.enabled=true",
            "--set", "erato.ingress.enabled=false",
        ])
    if args.storage_class:
        helm_args.extend(["--set", f"postgresql.storage.storageClass={args.storage_class}"])

    values = {
        "erato": {
            "ingress": {"annotations": {"nginx.ingress.kubernetes.io/proxy-buffer-size": "8k", "nginx.ingress.kubernetes.io/proxy-buffers-number": "4", "nginx.ingress.kubernetes.io/proxy-body-size": "0"}},
        }
    }
    if config.test_scenario == "entra_id":
        import tomllib

        try:
            with args.e2e_secrets_file.open("rb") as stream:
                entra_secrets = tomllib.load(stream)
            base_values = yaml.safe_load((chart_path / "values.yaml").read_text(encoding="utf-8"))
            base_config = base_values.get("erato", {}).get("oauth2Proxy", {}).get("config", "")
            config_dict = {}
            for line in base_config.splitlines():
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    config_dict[key.strip()] = value.strip()
            tenant = entra_secrets["entra_id_tenant_id"]
            client_id = entra_secrets["entra_id_client_id"]
            client_secret = entra_secrets["entra_id_client_secret"]
        except (OSError, KeyError, ValueError) as error:
            raise SystemExit(f"Could not load Entra credentials from {args.e2e_secrets_file}: {error}") from error
        config_dict.update({
            "provider": '"entra-id"',
            "oidc_issuer_url": f'"https://login.microsoftonline.com/{tenant}/v2.0"',
            "client_id": f'"{client_id}"',
            "client_secret": f'"{client_secret}"',
            "skip_oidc_discovery": "false",
            "scope": '"openid profile email offline_access"',
        })
        for key in ("login_url", "redeem_url", "oidc_jwks_url", "insecure_oidc_skip_issuer_verification"):
            config_dict.pop(key, None)
        values["erato"]["oauth2Proxy"] = {"config": "\n".join(f"{key} = {value}" for key, value in config_dict.items())}
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", prefix=f"{environment}-", delete=False) as stream:
        yaml.safe_dump(values, stream)
        values_path = Path(stream.name)
    atexit.register(lambda path=values_path: path.unlink(missing_ok=True))

    command = [
        "helm", "upgrade", "--install", release, str(chart_path),
        "--kubeconfig", str(args.kubeconfig),
        "--namespace", namespace,
        "--values", str(values_path),
        *[item for values_file in (args.values_file or []) for item in ["--values", str(values_file.resolve())]],
        *helm_args,
    ]
    if config.wait_flag:
        command.append(config.wait_flag)
    print(f"Deploying environment '{environment}' into namespace '{namespace}' using the supplied namespace-scoped kubeconfig")
    try:
        run_command(command)
    finally:
        values_path.unlink(missing_ok=True)
        for secret_temp_path in secret_temp_paths:
            secret_temp_path.unlink(missing_ok=True)
    print(f"Environment ready: {app_url}")
    print(f"Dex: {dex_url}")


def verify_deployer_kubeconfig(kubeconfig: Path, namespace: str, service_account: str) -> None:
    """Require an actual service-account token and deny cluster/cross-namespace access."""
    import base64
    import yaml

    try:
        config = yaml.safe_load(kubeconfig.read_text(encoding="utf-8"))
        token = config["users"][0]["user"]["token"]
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    except (OSError, KeyError, IndexError, TypeError, ValueError) as error:
        raise SystemExit("--kubeconfig must contain a service-account bearer token") from error
    expected_subject = f"system:serviceaccount:{namespace}:{service_account}"
    if claims.get("sub") != expected_subject:
        raise SystemExit(f"--kubeconfig identity must be {expected_subject}; got {claims.get('sub', 'unknown')}")

    kubectl = ["kubectl", "--kubeconfig", str(kubeconfig)]
    checks = [
        ("get", "deployments", "--namespace", namespace, "yes"),
        ("list", "namespaces", "no"),
        ("create", "namespaces", "no"),
        ("list", "pods", "--all-namespaces", "no"),
        ("get", "deployments", "--namespace", "kube-system", "no"),
    ]
    for check in checks:
        *permission, expected = check
        result = run_command([*kubectl, "auth", "can-i", *permission], capture_output=True, check=False)
        accepted_exit_code = result.returncode == 0 or (expected == "no" and result.returncode == 1)
        if not accepted_exit_code or result.stdout.strip().lower() != expected:
            raise SystemExit(f"Service account scope check failed: expected '{expected}' for kubectl auth can-i {' '.join(permission)}")


def main():
    parser = argparse.ArgumentParser(
        description="Setup local k3d development environment for Erato",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        "--wait",
        action="store_true",
        help="Wait for resources to be ready during Helm install"
    )
    parser.add_argument("--target", choices=["k3d", "existing"], default="k3d", help="Deploy to local k3d or an existing Kubernetes cluster")
    parser.add_argument("--environment", help="Unique DNS-safe identity for an isolated existing-cluster deployment")
    parser.add_argument("--namespace", help="Target namespace; defaults to erato-<environment> for existing-cluster deployments")
    parser.add_argument("--release-name", help="Helm release; defaults to erato-<environment> for existing-cluster deployments")
    parser.add_argument("--kubeconfig", type=Path, help="Namespace-scoped deployer kubeconfig from setup-dev-service-account")
    parser.add_argument("--deployer-service-account", default="erato-deployer", help="Service account expected in the supplied kubeconfig")
    parser.add_argument("--domain-suffix", default="tail1f0fbd.ts.net", help="Private DNS suffix (default: Tailscale tail1f0fbd.ts.net)")
    parser.add_argument("--ingress-class", default="tailscale", help="Existing ingress class (default: tailscale)")
    parser.add_argument("--tailscale-tags", default="tag:k8s-observability", help="Tailscale device tag for private ingress (default: tag:k8s-observability)")
    parser.add_argument("--tls-secret-name", help="Pre-provisioned namespace TLS Secret name (required for nginx ingress)")
    parser.add_argument("--storage-class", help="Storage class for the CNPG cluster")
    parser.add_argument("--scenario-secrets-file", type=Path, help="Per-environment generated scenario TOML to mount as a Secret")
    parser.add_argument("--e2e-secrets-file", type=Path, help="Private E2E source TOML (required for Entra ID OAuth configuration)")
    parser.add_argument("--values-file", type=Path, action="append", help="Additional per-environment Helm values file (repeatable)")
    parser.add_argument("--image-pull-secret", action="append", help="Namespace imagePullSecret name (repeatable)")
    parser.add_argument(
        "--build-local",
        action="store_true",
        help="Build images locally instead of pulling from registry"
    )
    parser.add_argument(
        "--erato-image-repository",
        default="registry.eratolabs.com/erato/app",
        help="Erato image repository (default: registry.eratolabs.com/erato/app)"
    )
    parser.add_argument(
        "--erato-image-tag",
        default=None,
        help="Erato image tag (if not specified, uses chart default). Use 'fetch-latest-main' to automatically fetch and use the latest commit from origin/main"
    )
    parser.add_argument(
        "--mock-llm-server-image-tag",
        default=None,
        help=(
            "Mock LLM server image tag. If omitted, falls back to --erato-image-tag "
            "when that is set."
        )
    )
    parser.add_argument(
        "--mock-mcp-server-image-tag",
        default=None,
        help=(
            "Mock MCP server image tag. If omitted, falls back to --erato-image-tag "
            "when that is set."
        )
    )
    parser.add_argument(
        "--chart-dep-update",
        action="store_true",
        help="Update Helm chart dependencies"
    )
    parser.add_argument(
        "--with-telepresence",
        action="store_true",
        help="Install Telepresence for local development"
    )
    parser.add_argument(
        "--file-storage-config",
        dest="file_storage_config_source",
        help="Source file for file storage config (e.g., 'config/erato.file-storage.toml')"
    )
    parser.add_argument(
        "--scenario",
        default="basic",
        choices=VALID_SCENARIOS,
        help=f"Test scenario to deploy (default: basic). Choices: {', '.join(VALID_SCENARIOS)}"
    )
    
    args = parser.parse_args()
    
    # Validate scenario
    if not validate_scenario(args.scenario):
        print(f"Error: Invalid scenario '{args.scenario}'", file=sys.stderr)
        print(f"Valid scenarios: {', '.join(VALID_SCENARIOS)}", file=sys.stderr)
        sys.exit(1)
    
    # Build configuration
    config = ScriptConfig(
        wait_flag="--wait" if args.wait else "",
        erato_image_repository=args.erato_image_repository,
        erato_image_tag=args.erato_image_tag,
        mock_llm_server_image_tag=args.mock_llm_server_image_tag,
        mock_mcp_server_image_tag=args.mock_mcp_server_image_tag,
        build_local=args.build_local,
        chart_dep_update=args.chart_dep_update,
        with_telepresence=args.with_telepresence,
        file_storage_config_source=args.file_storage_config_source,
        test_scenario=args.scenario
    )
    if args.image_pull_secret:
        pull_secrets = [{"name": name} for name in args.image_pull_secret]
        config.helm_set_args.extend([
            "--set-json", f"global.imagePullSecrets={json.dumps(pull_secrets)}",
            "--set-json", f"erato.global.imagePullSecrets={json.dumps(pull_secrets)}",
        ])

    # Resolve the image selector before either deployment target consumes it.
    if config.erato_image_tag == "fetch-latest-main":
        config.erato_image_tag = fetch_latest_main_commit()
    if config.mock_llm_server_image_tag == "fetch-latest-main":
        config.mock_llm_server_image_tag = fetch_latest_main_commit()
    if config.mock_mcp_server_image_tag == "fetch-latest-main":
        config.mock_mcp_server_image_tag = fetch_latest_main_commit()

    if args.target == "existing":
        if config.build_local:
            raise SystemExit("--build-local is only supported by the local k3d target")
        if config.with_telepresence:
            raise SystemExit("--with-telepresence is only supported by the local k3d target")
        if args.kubeconfig is None:
            raise SystemExit("--target existing requires --kubeconfig")
        if args.e2e_secrets_file and not args.e2e_secrets_file.is_file():
            raise SystemExit(f"E2E secrets file not found: {args.e2e_secrets_file}")
        for values_file in args.values_file or []:
            if not values_file.is_file():
                raise SystemExit(f"Helm values file not found: {values_file}")
        deploy_existing_environment(args, config)
        return

    cluster_config = ClusterConfig()

    # Change to infrastructure directory
    script_dir = Path(__file__).resolve().parent
    infrastructure_dir = script_dir.parent
    
    try:
        import os
        os.chdir(infrastructure_dir)
    except Exception as e:
        print(f"Error: Could not change to infrastructure directory: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Execute setup steps
    check_prerequisites()

    # Check E2E secrets configuration
    if not check_e2e_secrets():
        print("⚠️  WARNING: E2E secrets not configured.")
        print("   Run: ./scripts/setup-e2e-secrets apply")
        print("   See: infrastructure/k3d/erato-local/config/e2e-secrets.template.toml")
        print()

    create_or_use_cluster(cluster_config)
    
    # Switch kubectl context
    run_command(["kubectl", "config", "use-context", f"k3d-{cluster_config.cluster_name}"])
    
    wait_for_cluster()
    wait_for_coredns()
    
    add_helm_repos()
    update_chart_dependencies(config, cluster_config)
    
    # Configure Helm arguments
    helm_args = configure_helm_args(config)
    helm_args.extend([
        "--set", "erato.backend.loadBalancer.serviceAccount.create=false",
        "--set", "erato.backend.loadBalancer.serviceAccount.name=erato-local-erato-backend-load-balancer",
    ])
    
    # Handle local build if requested
    if config.build_local:
        print("Performing local build...")
        build_helm_args = perform_local_build(config)
        helm_args = build_helm_args  # Override with build-specific args
        helm_args.extend([
            "--set", "erato.backend.loadBalancer.serviceAccount.create=false",
            "--set", "erato.backend.loadBalancer.serviceAccount.name=erato-local-erato-backend-load-balancer",
        ])

    # Handle E2E scenario secrets
    # Check if any scenario secret files exist
    secrets_exist = any(
        (cluster_config.chart_path / f"config/erato.scenario-{scenario}.auto.toml").exists()
        for scenario in VALID_SCENARIOS
    )

    if secrets_exist:
        import json
        helm_args.extend(["--set", "scenarioSecretsConfig.enabled=true"])
        helm_args.extend(["--set", f"scenarioSecretsConfig.scenario={config.test_scenario}"])
        # Add E2E scenario data server ingress path for test credential access
        extra_ingress_paths = [
            {
                "path": "/e2e-scenario-data",
                "pathType": "Prefix",
                "backend": {
                    "service": {
                        "name": "{{ .Release.Name }}-e2e-scenario-data-server",
                        "port": {
                            "name": "http"
                        }
                    }
                }
            }
        ]
        helm_args.extend(["--set-json", f"erato.ingress.extraPaths={json.dumps(extra_ingress_paths)}"])
        # Build the complete extraConfigFiles array with the scenario secrets entry
        # Replace underscores with hyphens for K8s RFC 1123 compliance
        scenario_k8s_name = config.test_scenario.replace("_", "-")
        secret_name = f"erato-local-erato-scenario-{scenario_k8s_name}-secrets"
        extra_config_files = [
            {
                "name": "file-storage",
                "configMapName": "erato-local-erato-file-storage-config",
                "configMapKey": "erato.file-storage.toml"
            },
            {
                "name": "test-scenario",
                "configMapName": "erato-local-erato-test-scenario-config",
                "configMapKey": "erato.scenario.toml"
            },
            {
                "name": "scenario-secrets",
                "secretName": secret_name,
                "secretKey": "erato.scenario.auto.toml"
            },
            {
                "name": "frontend-env",
                "inlineContent": "[frontend.additional_environment]\nFOO_BAR = \"true\""
            }
        ]
        helm_args.extend(["--set-json", f"erato.backend.extraConfigFiles={json.dumps(extra_config_files)}"])

    # Handle OAuth2-Proxy configuration for entra_id scenario
    oauth2_values_file = None
    if secrets_exist and config.test_scenario == "entra_id":
        secrets_file = cluster_config.chart_path / "config" / "e2e-secrets.toml"

        if secrets_file.exists():
            try:
                import tomllib
                import yaml
                import tempfile

                # Load secrets
                with open(secrets_file, "rb") as f:
                    secrets = tomllib.load(f)

                # Read base oauth2-proxy config from values.yaml
                values_file = cluster_config.chart_path / "values.yaml"
                with open(values_file, "r") as f:
                    values_data = yaml.safe_load(f)
                base_config = values_data.get("erato", {}).get("oauth2Proxy", {}).get("config", "")

                # Parse base config into a dictionary
                config_dict = {}
                for line in base_config.split('\n'):
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        key, value = line.split('=', 1)
                        config_dict[key.strip()] = value.strip()

                # Apply Entra ID overrides
                config_dict['provider'] = '"entra-id"'
                config_dict['oidc_issuer_url'] = f'"https://login.microsoftonline.com/{secrets["entra_id_tenant_id"]}/v2.0"'
                config_dict['client_id'] = f'"{secrets["entra_id_client_id"]}"'
                config_dict['client_secret'] = f'"{secrets["entra_id_client_secret"]}"'
                config_dict['skip_oidc_discovery'] = 'false'
                config_dict['scope'] = '"openid profile email offline_access"'

                # Remove Dex-specific fields that Entra ID doesn't need
                config_dict.pop('login_url', None)
                config_dict.pop('redeem_url', None)
                config_dict.pop('oidc_jwks_url', None)
                config_dict.pop('insecure_oidc_skip_issuer_verification', None)

                # Reconstruct config
                merged_lines = [f"{k} = {v}" for k, v in config_dict.items()]
                merged_config = '\n'.join(merged_lines)

                # Write to a temporary values file
                # Using a values file preserves multiline strings properly
                oauth2_values = {
                    "erato": {
                        "oauth2Proxy": {
                            "config": merged_config
                        }
                    }
                }

                # Create temp file that won't be auto-deleted
                fd, oauth2_values_file = tempfile.mkstemp(suffix='.yaml', text=True)
                with os.fdopen(fd, 'w') as f:
                    yaml.dump(oauth2_values, f)
                atexit.register(lambda path=oauth2_values_file: Path(path).unlink(missing_ok=True))

                helm_args.extend(["-f", oauth2_values_file])

                print(f"✓ Configured oauth2-proxy for Entra ID authentication")

            except Exception as e:
                print(f"Warning: Could not merge oauth2-proxy config: {e}", file=sys.stderr)

    # Handle file storage config
    file_storage_args = handle_file_storage_config(config)
    helm_args.extend(file_storage_args)

    # Configure mock-llm-server image values
    helm_args.extend(configure_mock_llm_server_helm_args(config))

    # Configure mock-mcp-server image values
    helm_args.extend(configure_mock_mcp_server_helm_args(config))
    
    # Handle test scenario
    scenario_args = get_helm_scenario_args(config.test_scenario)
    helm_args.extend(scenario_args)

    # Handle nginx-auth scenario - disable oauth2-proxy and dex, enable nginxAuth
    if config.test_scenario == "nginx-auth":
        print("Configuring nginx-auth scenario: disabling oauth2-proxy and Dex, enabling nginx-auth")
        helm_args.extend(["--set", "erato.oauth2Proxy.enabled=false"])
        helm_args.extend(["--set", "dex.enabled=false"])
        helm_args.extend(["--set", "nginxAuth.enabled=true"])
        helm_args.extend(["--set", "erato.ingress.enabled=false"])

    # Install components
    install_nginx_ingress()
    install_telepresence(config)
    install_cnpg()
    install_reloader()
    
    # Wait for webhooks
    wait_for_webhook("ingress-nginx", "ingress-nginx-controller-admission", "NGINX admission webhook")
    wait_for_webhook("cnpg-system", "cnpg-webhook-service", "CNPG webhook")

    # Cluster-level setup above uses the developer's context. Install and
    # upgrade the application itself only with the namespace-scoped account.
    import json as json_module
    import os as os_module
    import tempfile as tempfile_module

    issuer_config = run_command([
        "kubectl", "config", "view", "--raw", "--flatten", "--minify", "-o", "json",
    ], capture_output=True).stdout
    issuer_fd, issuer_name = tempfile_module.mkstemp(prefix="erato-admin-kubeconfig-")
    try:
        os_module.fchmod(issuer_fd, 0o600)
        with os_module.fdopen(issuer_fd, "w", encoding="utf-8") as issuer_stream:
            json_module.dump(json_module.loads(issuer_config), issuer_stream)
        deployment_kubeconfig = Path.home() / ".kube" / "erato-dev-deployer.yaml"
        run_command([
            str(script_dir / "setup-dev-service-account"), "provision",
            "--issuer-kubeconfig", issuer_name,
            "--namespace", "erato-local-ns",
            "--service-account", "erato-deployer",
            "--release-name", "erato-local",
            "--output-kubeconfig", str(deployment_kubeconfig),
        ])
        config.deployment_kubeconfig = deployment_kubeconfig
        install_erato_chart(config, cluster_config, helm_args)
    finally:
        Path(issuer_name).unlink(missing_ok=True)

    # Clean up temporary values file if it was created
    if oauth2_values_file and os.path.exists(oauth2_values_file):
        try:
            os.unlink(oauth2_values_file)
        except Exception:
            pass  # Ignore cleanup errors

    # Ensure DNS entries
    ensure_hosts_entries(cluster_config)

    # Print completion message
    print_completion_message(cluster_config, config)


if __name__ == "__main__":
    main()
