#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Provision a namespace and a least-privilege Helm deployer account."""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


def run(command: list[str], *, input_text: str | None = None) -> str:
    try:
        result = subprocess.run(
            command,
            input=input_text,
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as error:
        if error.stderr:
            print(error.stderr, file=sys.stderr, end="")
        raise SystemExit(error.returncode) from error
    except FileNotFoundError as error:
        raise SystemExit(f"Required command not found: {command[0]}") from error
    return result.stdout.strip()


def kubectl_args(kubeconfig: Path | None, context: str | None) -> list[str]:
    args = ["kubectl"]
    if kubeconfig:
        args.extend(["--kubeconfig", str(kubeconfig)])
    if context:
        args.extend(["--context", context])
    return args


def validate_name(value: str, description: str) -> str:
    if not re.fullmatch(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?", value) or len(value) > 63:
        raise SystemExit(f"{description} must be a Kubernetes DNS label (max 63 characters): {value}")
    return value


def create_manifest(namespace: str, service_account: str, load_balancer_account: str) -> str:
    """Build namespace-scoped deployment and backend-reader RBAC resources."""
    return f"""apiVersion: v1
kind: Namespace
metadata:
  name: {namespace}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {service_account}
  namespace: {namespace}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {service_account}
  namespace: {namespace}
rules:
- apiGroups: [""]
  resources: ["configmaps", "events", "persistentvolumeclaims", "pods", "pods/log", "secrets", "services", "serviceaccounts"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["apps"]
  resources: ["deployments", "replicasets", "statefulsets"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["batch"]
  resources: ["jobs"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["networking.k8s.io"]
  resources: ["ingresses", "networkpolicies"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["postgresql.cnpg.io"]
  resources: ["clusters"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {service_account}
  namespace: {namespace}
subjects:
- kind: ServiceAccount
  name: {service_account}
  namespace: {namespace}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {service_account}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {load_balancer_account}
  namespace: {namespace}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {load_balancer_account}
  namespace: {namespace}
rules:
- apiGroups: [""]
  resources: ["configmaps", "endpoints", "pods", "services", "secrets"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["discovery.k8s.io"]
  resources: ["endpointslices"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["networking.k8s.io"]
  resources: ["ingresses"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {load_balancer_account}
  namespace: {namespace}
subjects:
- kind: ServiceAccount
  name: {load_balancer_account}
  namespace: {namespace}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {load_balancer_account}
"""


def get_cluster_connection(kubectl: list[str], context: str | None) -> tuple[str, str]:
    command = [*kubectl, "config", "view", "--raw", "--flatten", "--minify", "-o", "json"]
    if context:
        command.extend(["--context", context])
    data = json.loads(run(command))
    clusters = data.get("clusters", [])
    if not clusters:
        raise SystemExit("Could not read a cluster from the selected issuer kubeconfig")
    cluster = clusters[0]["cluster"]
    server = cluster.get("server")
    ca_data = cluster.get("certificate-authority-data")
    if not server or not ca_data:
        raise SystemExit("Issuer kubeconfig must provide a cluster API server and CA certificate")
    return server, ca_data


def issue_token(kubectl: list[str], service_account: str, namespace: str, duration: str) -> tuple[str, str]:
    duration_hours = int(duration[:-1]) if duration.endswith("h") and duration[:-1].isdigit() else 0
    if duration_hours < 336 or duration_hours > 720:
        raise SystemExit("Requested token lifetime must be between 336h (14 days) and 720h (30 days)")
    token = run([*kubectl, "create", "token", service_account, "--namespace", namespace, "--duration", duration])
    import base64
    try:
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    except (IndexError, ValueError, json.JSONDecodeError) as error:
        raise SystemExit("The API server returned an invalid service-account token") from error
    expiry = claims.get("exp")
    if not expiry:
        raise SystemExit("The issued service-account token has no expiry claim")
    expires_at = datetime.fromtimestamp(expiry, tz=timezone.utc).isoformat()
    return token, expires_at


def write_kubeconfig(path: Path, context_name: str, namespace: str, server: str, ca_data: str, token: str) -> None:
    """Write a standalone kubeconfig atomically with owner-only permissions."""
    config = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [{"name": context_name, "cluster": {"server": server, "certificate-authority-data": ca_data}}],
        "users": [{"name": f"{context_name}-deployer", "user": {"token": token}}],
        "contexts": [{"name": context_name, "context": {"cluster": context_name, "user": f"{context_name}-deployer", "namespace": namespace}}],
        "current-context": context_name,
    }
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(config, stream, indent=2)
            stream.write("\n")
        os.replace(temp_name, path)
        os.chmod(path, 0o600)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def verify_scope(kubeconfig: Path, namespace: str) -> None:
    """Reject a generated deployer credential with permissions beyond its namespace."""
    kubectl = kubectl_args(kubeconfig, None)
    checks = (
        (("get", "deployments", "--namespace", namespace), "yes"),
        (("list", "namespaces"), "no"),
        (("create", "namespaces"), "no"),
        (("list", "pods", "--all-namespaces"), "no"),
        (("get", "deployments", "--namespace", "kube-system"), "no"),
    )
    for args, expected in checks:
        result = subprocess.run(
            [*kubectl, "auth", "can-i", *args],
            check=False,
            capture_output=True,
            text=True,
        )
        actual = result.stdout.strip().lower()
        expected_return_code = 0 if expected == "yes" else 1
        if actual != expected or result.returncode != expected_return_code:
            raise SystemExit(
                f"Service account scope check failed: expected '{expected}' for kubectl auth can-i {' '.join(args)}"
            )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name in ("provision", "renew"):
        sub = subparsers.add_parser(name)
        sub.add_argument("--issuer-kubeconfig", type=Path, required=True, help="Kubeconfig for your existing authorized identity")
        sub.add_argument("--issuer-context", help="Context in the issuer kubeconfig")
        sub.add_argument("--namespace", required=True)
        sub.add_argument("--service-account", default="erato-deployer")
        sub.add_argument("--duration", default="720h", help="Requested token lifetime (14–30 days; default 30 days)")
        sub.add_argument("--output-kubeconfig", type=Path, required=True)
        if name == "provision":
            sub.add_argument("--release-name", default="erato-local")
            sub.add_argument("--tls-secret-name", help="Import a pre-issued certificate and key into the namespace")
            sub.add_argument("--tls-cert", type=Path)
            sub.add_argument("--tls-key", type=Path)

    args = parser.parse_args()
    namespace = validate_name(args.namespace, "Namespace")
    service_account = validate_name(args.service_account, "Service account")
    issuer = kubectl_args(args.issuer_kubeconfig, args.issuer_context)

    if args.command == "provision":
        release = validate_name(args.release_name, "Release name")
        load_balancer_account = validate_name(f"{release}-erato-backend-load-balancer", "Load-balancer service account")
        if bool(args.tls_cert) != bool(args.tls_key):
            raise SystemExit("--tls-cert and --tls-key must be provided together")
        if args.tls_secret_name and not args.tls_cert:
            raise SystemExit("--tls-secret-name requires --tls-cert and --tls-key")
        if args.tls_cert:
            tls_secret = validate_name(args.tls_secret_name or "erato-ingress-tls", "TLS secret name")
        else:
            tls_secret = None
        manifest = create_manifest(namespace, service_account, load_balancer_account)
        run([*issuer, "apply", "-f", "-"], input_text=manifest)
        if tls_secret:
            secret_manifest = run([
                *issuer, "create", "secret", "tls", tls_secret,
                "--namespace", namespace,
                "--cert", str(args.tls_cert),
                "--key", str(args.tls_key),
                "--dry-run=client", "-o", "yaml",
            ])
            run([*issuer, "apply", "-f", "-"], input_text=secret_manifest)

    server, ca_data = get_cluster_connection(issuer, args.issuer_context)
    token, expires_at = issue_token(issuer, service_account, namespace, args.duration)
    context_name = f"{namespace}-deployer"
    write_kubeconfig(args.output_kubeconfig, context_name, namespace, server, ca_data, token)
    try:
        verify_scope(args.output_kubeconfig, namespace)
    except (Exception, SystemExit):
        args.output_kubeconfig.unlink(missing_ok=True)
        raise
    print(f"Wrote namespace-scoped kubeconfig: {args.output_kubeconfig}")
    print(f"Token expires at: {expires_at}")
    print("Use this kubeconfig for application deployments. Renew with your own authorized issuer kubeconfig before expiry.")


if __name__ == "__main__":
    main()
