<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">
  <Id>{{OFFICE_ADDIN_ID}}</Id>
  <Version>{{OFFICE_ADDIN_MANIFEST_VERSION}}</Version>
  <ProviderName>{{OFFICE_ADDIN_MANIFEST_PROVIDER_NAME}}</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="{{OFFICE_ADDIN_MANIFEST_DISPLAY_NAME}}" />
  <Description DefaultValue="{{OFFICE_ADDIN_MANIFEST_DESCRIPTION}}" />
  <IconUrl DefaultValue="{{OFFICE_ADDIN_MANIFEST_ICON_URL}}" />
  <HighResolutionIconUrl DefaultValue="{{OFFICE_ADDIN_MANIFEST_HIGH_RESOLUTION_ICON_URL}}" />
  <SupportUrl DefaultValue="{{OFFICE_ADDIN_MANIFEST_SUPPORT_URL}}" />
  <!--
    Host-neutral by design: the add-in is named for documents, not for Word,
    so Excel and PowerPoint later join THIS catalog entry by adding their own
    <Host> and bumping <Version> — one admin action instead of a second entry
    and a second install. v1 declares the Word host alone, because an
    admin-deployed host downloads on next launch, making a declared host a
    live promise that must not run ahead of its facets.
  -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <!--
    Activation floor. Erato does not support end-of-support builds, and
    Office LTSC 2021 leaves support on 2026-10-14, so the floor is the
    WordApi version the supported estate all clears. Below it the add-in
    simply does not appear, with no error message. That is intended.
  -->
  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.7" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3002/public/platform-office-addin/word" />
  </DefaultSettings>
  <!--
    ReadWriteDocument is declared up front even though this manifest version
    only opens the pane. Delivery is one manifest deployed once per customer
    through a catalog or the Integrated apps portal, so narrowing it now would
    force a manifest re-deploy and a second admin consent when reading and
    writing land — exactly what the one-manifest decision exists to avoid.
  -->
  <Permissions>ReadWriteDocument</Permissions>
  <!--
    The ribbon button is an additive affordance, not the way in: the
    SharePoint app catalog route carries no ribbon button and no context
    menu, the same path iPad already needs, so everything must also be
    reachable inside the pane once it is open.

    This element deliberately carries NO Requirements child. A requirement
    here gates the commands node, and Microsoft describes the SharePoint
    catalog as unsupported for add-ins with any feature requiring a
    version-overrides element. Keeping the node requirement-free is part of
    what lets ONE manifest serve both delivery routes.

    None of the OFFICE_ADDIN_MANIFEST_LAUNCH_EVENT_* placeholders appear in
    this file: `manifest_supports_launch_events` is true only for the mail
    manifest, and this variant must render none.
  -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="eratoGroup">
                <Label resid="groupLabel" />
                <Icon>
                  <bt:Image size="16" resid="icon16" />
                  <bt:Image size="32" resid="icon32" />
                  <bt:Image size="80" resid="icon80" />
                </Icon>
                <Control xsi:type="Button" id="eratoTaskpaneButton">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="buttonLabel" />
                    <Description resid="buttonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>eratoTaskpane</TaskpaneId>
                    <SourceLocation resid="taskPaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="{{OFFICE_ADDIN_MANIFEST_ICON_16_URL}}" />
        <bt:Image id="icon32" DefaultValue="{{OFFICE_ADDIN_MANIFEST_ICON_32_URL}}" />
        <bt:Image id="icon80" DefaultValue="{{OFFICE_ADDIN_MANIFEST_ICON_80_URL}}" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskPaneUrl" DefaultValue="https://localhost:3002/public/platform-office-addin/word" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="{{OFFICE_ADDIN_MANIFEST_GROUP_LABEL}}" />
        <bt:String id="buttonLabel" DefaultValue="{{OFFICE_ADDIN_MANIFEST_BUTTON_LABEL}}" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonDesc" DefaultValue="{{OFFICE_ADDIN_MANIFEST_BUTTON_DESCRIPTION}}" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
