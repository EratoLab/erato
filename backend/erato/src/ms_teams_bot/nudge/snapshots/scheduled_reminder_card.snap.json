{
  "type": "message",
  "summary": "Call Alex back",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [
          {
            "type": "TextBlock",
            "text": "Call Alex back",
            "wrap": true,
            "weight": "Bolder",
            "size": "Medium"
          },
          {
            "type": "TextBlock",
            "text": "Ask whether they need the revised rates before Friday.",
            "wrap": true
          },
          {
            "type": "TextBlock",
            "text": "Linked chat: [Q4 rate comparison](https://erato.example.com/chat/CHAT_ID)",
            "wrap": true,
            "isSubtle": true,
            "size": "Small",
            "spacing": "Small"
          }
        ],
        "actions": [
          {
            "type": "Action.Submit",
            "title": "Continue here",
            "data": {
              "action": "erato_delivery_action",
              "delivery_id": "DELIVERY_ID",
              "command": "continue",
              "target": "CHAT_ID"
            }
          },
          {
            "type": "Action.Submit",
            "title": "Done",
            "data": {
              "action": "erato_delivery_action",
              "delivery_id": "DELIVERY_ID",
              "command": "done",
              "token": "TOKEN"
            }
          },
          {
            "type": "Action.Submit",
            "title": "Snooze 30 min",
            "data": {
              "action": "erato_delivery_action",
              "delivery_id": "DELIVERY_ID",
              "command": "snooze",
              "token": "TOKEN"
            }
          },
          {
            "type": "Action.Submit",
            "title": "Tomorrow 9:00",
            "data": {
              "action": "erato_delivery_action",
              "delivery_id": "DELIVERY_ID",
              "command": "tomorrow",
              "token": "TOKEN"
            }
          }
        ]
      }
    }
  ]
}
