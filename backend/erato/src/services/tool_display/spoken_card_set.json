    {
      "id": "create-09-note-very-long",
      "group": "create",
      "server": "dynamics",
      "tool": "create_record",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "arguments": {
        "tablename": "annotation",
        "item": {
          "subject": "Gesprächsnotiz Werksbesuch",
          "notetext": "Teilnehmer waren Frau Müller, Herr Schmidt und zwei Kollegen aus der Instandhaltung. Wir haben die Linie 4 vollständig begangen und die Engstellen an der Übergabe zwischen Presse und Förderband besprochen. Die bestehende Steuerung ist zwölf Jahre alt, Ersatzteile sind nur noch über Dritthändler zu bekommen. Frau Müller möchte den Umbau in die Betriebsferien legen, also in die erste Augustwoche. Herr Schmidt hat darauf hingewiesen, dass der Einkauf ein verbindliches Angebot bis Ende Februar braucht, damit das Budget im ersten Quartal freigegeben werden kann. Offen ist, ob die Schaltschränke am bisherigen Platz bleiben. Dafür brauchen wir die Zeichnungen der Fördertechnik, die Frau Müller bis Ende November schickt. Außerdem wurde vereinbart, dass wir eine Abschätzung der Stillstandszeit liefern, getrennt nach mechanischem Umbau und Inbetriebnahme. Die Instandhaltung wünscht eine Schulung für drei Personen vor der Inbetriebnahme. Als nächster Schritt schicken wir einen Terminvorschlag für eine zweite Begehung mit unserem Elektroplaner. Die Stimmung war gut, das Projekt hat hohe Priorität, weil die Linie 4 im Moment der Engpass im Werk ist.",
          "objectid": {
            "recordId": "5f0c2a10-0000-4000-8000-00000000a001",
            "relatedTable": "opportunity"
          }
        }
      }
    },
