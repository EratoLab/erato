{
  "binding": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/binding.schema.json",
    "title": "LocalTaskBinding",
    "type": "object",
    "properties": {
      "backendOrigin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "accountId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "deviceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "taskId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "jobId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "attemptId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "toolCallId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "planDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      }
    },
    "required": [
      "backendOrigin",
      "accountId",
      "deviceId",
      "taskId",
      "jobId",
      "attemptId",
      "toolCallId",
      "planDigest"
    ],
    "additionalProperties": false
  },
  "plan": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/plan.schema.json",
    "title": "LocalTaskPlan",
    "type": "object",
    "properties": {
      "operation": {
        "const": "collect_evidence"
      },
      "queryVariants": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "maxHits": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "maxArtifacts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "maxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12582912
      },
      "executionSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "operation",
      "queryVariants",
      "maxHits",
      "maxArtifacts",
      "maxBytes",
      "executionSeconds",
      "expiresAt"
    ],
    "additionalProperties": false
  },
  "context-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/context-claims.schema.json",
    "title": "LocalContextClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-context-v1"
      },
      "sub": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "origin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "deviceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "challenge": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "jti": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "iat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "sub",
      "origin",
      "deviceId",
      "challenge",
      "jti",
      "iat",
      "exp"
    ],
    "additionalProperties": false
  },
  "job-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/job-claims.schema.json",
    "title": "LocalJobClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-job-v1"
      },
      "sub": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "origin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "jti": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "iat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "sub",
      "origin",
      "binding",
      "jti",
      "iat",
      "exp"
    ],
    "additionalProperties": false
  },
  "receipt-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/receipt-claims.schema.json",
    "title": "LocalExportReceiptClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-export-receipt-v1"
      },
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "exportId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "manifestDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      },
      "receiptId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "acceptedAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "binding",
      "exportId",
      "manifestDigest",
      "receiptId",
      "acceptedAt"
    ],
    "additionalProperties": false
  },
  "approved-export": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/approved-export.schema.json",
    "title": "ApprovedLocalExport",
    "type": "object",
    "properties": {
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "exportId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "grantId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "manifestDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      },
      "approvedAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "artifacts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{32,128}$"
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "mediaType": {
              "enum": [
                "text/plain",
                "message/rfc822",
                "application/octet-stream",
                "application/json",
                "application/pdf"
              ]
            },
            "sha256": {
              "$ref": "../common.schema.json#/definitions/Digest"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12582912
            },
            "contentBase64": {
              "type": "string",
              "maxLength": 16777216,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "artifactId",
            "filename",
            "mediaType",
            "sha256",
            "byteLength",
            "contentBase64"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "binding",
      "exportId",
      "snapshotId",
      "grantId",
      "manifestDigest",
      "approvedAt",
      "expiresAt",
      "artifacts"
    ],
    "additionalProperties": false
  },
  "common": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/common.schema.json",
    "title": "CommonProtocolTypes",
    "definitions": {
      "ProtocolVersion": {
        "type": "string",
        "pattern": "^[1-9][0-9]*\\.[0-9]+$"
      },
      "RequestId": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "integer"
          }
        ]
      },
      "Digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "Revision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "ProductInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": true
      },
      "CatalogueIdentity": {
        "type": "object",
        "required": [
          "revision",
          "digest"
        ],
        "properties": {
          "revision": {
            "$ref": "#/definitions/Revision"
          },
          "digest": {
            "$ref": "#/definitions/Digest"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
