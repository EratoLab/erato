{
  "binding": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/binding.schema.json",
    "title": "LocalTaskBinding",
    "type": "object",
    "properties": {
      "backendOrigin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "accountId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "deviceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "taskId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "jobId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "attemptId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "toolCallId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "planDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      }
    },
    "required": [
      "backendOrigin",
      "accountId",
      "deviceId",
      "taskId",
      "jobId",
      "attemptId",
      "toolCallId",
      "planDigest"
    ],
    "additionalProperties": true
  },
  "plan": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/plan.schema.json",
    "title": "LocalTaskPlan",
    "type": "object",
    "properties": {
      "operation": {
        "const": "collect_evidence"
      },
      "queryVariants": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "maxHits": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "maxArtifacts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "maxBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12582912
      },
      "executionSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "operation",
      "queryVariants",
      "maxHits",
      "maxArtifacts",
      "maxBytes",
      "executionSeconds",
      "expiresAt"
    ],
    "additionalProperties": true
  },
  "context-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/context-claims.schema.json",
    "title": "LocalContextClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-context-v1"
      },
      "sub": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "origin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "deviceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "challenge": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "jti": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "iat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "sub",
      "origin",
      "deviceId",
      "challenge",
      "jti",
      "iat",
      "exp"
    ],
    "additionalProperties": true
  },
  "job-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/job-claims.schema.json",
    "title": "LocalJobClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-job-v1"
      },
      "sub": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "origin": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "jti": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "iat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "sub",
      "origin",
      "binding",
      "jti",
      "iat",
      "exp"
    ],
    "additionalProperties": true
  },
  "receipt-claims": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/receipt-claims.schema.json",
    "title": "LocalExportReceiptClaims",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "aud": {
        "const": "erato-local-export-receipt-v1"
      },
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "exportId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "manifestDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      },
      "receiptId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "acceptedAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "iss",
      "aud",
      "binding",
      "exportId",
      "manifestDigest",
      "receiptId",
      "acceptedAt"
    ],
    "additionalProperties": true
  },
  "approved-export": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/delegation/approved-export.schema.json",
    "title": "ApprovedLocalExport",
    "type": "object",
    "properties": {
      "binding": {
        "$ref": "../delegation/binding.schema.json"
      },
      "exportId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "grantId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{32,128}$"
      },
      "manifestDigest": {
        "$ref": "../common.schema.json#/definitions/Digest"
      },
      "approvedAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "expiresAt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "artifacts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{32,128}$"
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "mediaType": {
              "enum": [
                "text/plain",
                "message/rfc822",
                "application/octet-stream",
                "application/json",
                "application/pdf"
              ]
            },
            "sha256": {
              "$ref": "../common.schema.json#/definitions/Digest"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12582912
            },
            "contentBase64": {
              "type": "string",
              "maxLength": 16777216,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "outlookProvenance": {
              "description": "Where the artifact came from: the message's own reference as `document`, or an attachment's containing message as `topLevelParent`. A navigation hint for opening the original, never a grant.",
              "allOf": [
                {
                  "$ref": "../outlook/file-provenance.schema.json"
                }
              ]
            }
          },
          "required": [
            "artifactId",
            "filename",
            "mediaType",
            "sha256",
            "byteLength",
            "contentBase64"
          ],
          "additionalProperties": true
        }
      }
    },
    "required": [
      "binding",
      "exportId",
      "snapshotId",
      "grantId",
      "manifestDigest",
      "approvedAt",
      "expiresAt",
      "artifacts"
    ],
    "additionalProperties": true
  },
  "file-provenance": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/outlook/file-provenance.schema.json",
    "title": "OutlookFileProvenance",
    "description": "Versioned Outlook source metadata for an uploaded file. Multiple origins preserve distinct containing messages when identical bytes are deduplicated. This standalone contract does not add a field to existing v1 RPC responses.",
    "type": "object",
    "properties": {
      "version": {
        "type": "integer",
        "const": 1
      },
      "origins": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "document": {
              "description": "The uploaded email's own message reference. Omit for an ordinary file attachment with no message identity. For a thread export, identifies the requested subject only.",
              "allOf": [
                {
                  "$ref": "./message-reference.schema.json"
                }
              ]
            },
            "topLevelParent": {
              "description": "The outermost containing mailbox message. Never substitute this reference for the uploaded document's own identity.",
              "allOf": [
                {
                  "$ref": "./message-reference.schema.json"
                }
              ]
            }
          },
          "additionalProperties": true,
          "minProperties": 1
        }
      }
    },
    "required": [
      "version",
      "origins"
    ],
    "additionalProperties": true
  },
  "message-reference": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/outlook/message-reference.schema.json",
    "title": "OutlookMessageReference",
    "description": "A reference to one Outlook message, preserving its own identifiers and mailbox context. This is metadata, not an instruction or proof that the item is accessible.",
    "type": "object",
    "properties": {
      "documentId": {
        "description": "Originating sidecar catalog UUID, when indexed. Requires resolution against that catalog and is not portable across devices.",
        "type": "string",
        "format": "uuid"
      },
      "external_ids": {
        "allOf": [
          {
            "$ref": "../source/external-ids.schema.json"
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {},
                "value": {}
              },
              "if": {
                "properties": {
                  "key": {
                    "enum": [
                      "outlook_entry_id",
                      "outlook_store_id"
                    ]
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": true
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-fA-F]{2})+$"
                  }
                },
                "additionalProperties": true
              },
              "additionalProperties": true
            }
          }
        ]
      },
      "mailbox": {
        "$ref": "./mailbox-reference.schema.json"
      }
    },
    "required": [
      "external_ids"
    ],
    "anyOf": [
      {
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "description": "Originating sidecar catalog UUID, when indexed. Requires resolution against that catalog and is not portable across devices.",
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": true
      },
      {
        "properties": {
          "external_ids": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    ],
    "additionalProperties": true
  },
  "mailbox-reference": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/outlook/mailbox-reference.schema.json",
    "title": "OutlookMailboxReference",
    "description": "Mailbox context captured with a message reference. Local IDs are scoped to the originating Outlook installation; emailAddress identifies the mailbox owner, including a shared mailbox, not necessarily the signed-in user.",
    "type": "object",
    "properties": {
      "mailboxId": {
        "description": "Local sidecar mailbox ID. Both the compact Outlook RPC spelling and the UUID spelling used by search are accepted. Not a Microsoft Graph mailbox ID or a portable device identity.",
        "type": "string",
        "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
      },
      "emailAddress": {
        "description": "SMTP address of the mailbox owning the referenced item, when known.",
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      },
      "profileName": {
        "description": "Name of the originating Outlook profile, when available. A profile name alone does not identify a mailbox.",
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      }
    },
    "anyOf": [
      {
        "required": [
          "mailboxId"
        ],
        "properties": {
          "mailboxId": {
            "description": "Local sidecar mailbox ID. Both the compact Outlook RPC spelling and the UUID spelling used by search are accepted. Not a Microsoft Graph mailbox ID or a portable device identity.",
            "type": "string",
            "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
          }
        },
        "additionalProperties": true
      },
      {
        "required": [
          "emailAddress"
        ],
        "properties": {
          "emailAddress": {
            "description": "SMTP address of the mailbox owning the referenced item, when known.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    ],
    "additionalProperties": true
  },
  "external-ids": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/source/external-ids.schema.json",
    "title": "DocumentExternalIds",
    "description": "Externally relatable identifiers for the document. Identifier keys are open-ended so new identifier kinds do not require a protocol change.",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": true
    }
  },
  "common": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://schemas.erato.ai/desktop-sidecar/v1/common.schema.json",
    "title": "CommonProtocolTypes",
    "definitions": {
      "ProtocolVersion": {
        "type": "string",
        "pattern": "^[1-9][0-9]*\\.[0-9]+$"
      },
      "RequestId": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "integer"
          }
        ]
      },
      "Digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "Revision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "ProductInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": true
      },
      "CatalogueIdentity": {
        "type": "object",
        "required": [
          "revision",
          "digest"
        ],
        "properties": {
          "revision": {
            "$ref": "#/definitions/Revision"
          },
          "digest": {
            "$ref": "#/definitions/Digest"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
