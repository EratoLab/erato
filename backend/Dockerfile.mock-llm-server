# cargo-chef version = 0.1.78
# Rust version = 1.99.1 - Should be kept up-to-date with rust-toolchain.toml
# Trixie = Debian 13 -> LTS support until 2030
# Pinned for security & build performance reasons
FROM lukemathwalker/cargo-chef:0.1.78-rust-1.99.1-trixie@sha256:420b7375dc4059a85f1c365f23f96b8f561c2861e365645b413c531b206c528a AS chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --bin mock-llm-server --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --bin mock-llm-server --release --recipe-path recipe.json

# Build application binary
COPY . .
RUN cargo build --locked --release -p mock-llm-server --bin mock-llm-server

# Pinned for security & build performance reasons
FROM debian:trixie-slim@sha256:5cf544fad978371b3df255b61e209b373583cb88b733475c86e49faa15ac2104

WORKDIR /app

# Install only runtime certificates.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/mock-llm-server /app/mock-llm-server

EXPOSE 44320

ENV HOST="0.0.0.0"
ENV PORT="44320"

CMD ["./mock-llm-server"]
